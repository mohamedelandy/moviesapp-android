<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161616"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_medium_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F2542D"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="NOW PLAYING"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_medium_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="38:14 / 54m"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_medium_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Solaris Echo"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_medium_ep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S1:E1 • The Resonance Fold (360° Atmos)"
            android:textColor="#22D3EE"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/widget_medium_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="68"
            android:progressTint="#F2542D" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginStart="12dp">

        <ImageView
            android:id="@+id/widget_medium_play_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_media_play"
            android:background="#F2542D"
            android:contentDescription="Play" />

        <ImageView
            android:id="@+id/widget_medium_next_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_media_next"
            android:background="#333333"
            android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
