# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored and must never be committed.
#
# The Gradle build reads this file via the Secrets Gradle Plugin and injects the
# values into BuildConfig. Leave a value blank to omit it from the APK.

# Required for Gemini AI API calls. Get one at https://aistudio.google.com/apikey
#
# This file is also the Gradle build's "default properties" file: any key defined
# here but absent from .env is injected into BuildConfig with THIS value. An empty
# value is not valid and breaks the generated BuildConfig.java, so keep the
# placeholder. It is a non-functional dummy and is safe to ship.
GEMINI_API_KEY=MY_GEMINI_API_KEY
